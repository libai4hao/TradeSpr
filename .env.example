# 天气数据源配置（安全抽离）
# 真实 API Key 请在 .env 中设置，不要提交到代码仓库
# 当前使用 mock 数据作为兜底，后续可切换为真实 API

# VITE_WEATHER_API_URL: 真实天气 API 基础地址（可选，留空则使用 mock）
VITE_WEATHER_API_URL=

# VITE_WEATHER_API_KEY: 真实天气 API 密钥（可选，留空则使用 mock）
VITE_WEATHER_API_KEY=

# VITE_WEATHER_SOURCE: 数据源类型，mock | real（默认 mock 保证安全与稳定）
VITE_WEATHER_SOURCE=real

# VITE_WEATHER_REFRESH_INTERVAL_MINUTES: 定时自动刷新间隔（分钟），默认 30
VITE_WEATHER_REFRESH_INTERVAL_MINUTES=30
