# 真实环境变量（不提交到 git）
# 从 .env.example 复制后填入真实值
# CMA API 配置（根据官方文档 https://open-meteo.com/en/docs/cma-api#location_and_time）
# 使用 Open-Meteo 官方 forecast 端点（已包含 CMA GFS GRAPES 数据）
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
VITE_WEATHER_API_KEY=
VITE_WEATHER_SOURCE=real
VITE_WEATHER_REFRESH_INTERVAL_MINUTES=30
